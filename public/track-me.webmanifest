{
  "id": "/track-me",
  "name": "Ahsan's Updates",
  "short_name": "Ahsan Updates",
  "description": "Private family journal. Sign in to see Ahsan's daily updates.",
  "start_url": "/track-me",
  "scope": "/track-me",
  "display": "standalone",
  "background_color": "#f5f7f6",
  "theme_color": "#246c55",
  "orientation": "any",
  "icons": [
    {
      "src": "/track-me-icon-v29-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/track-me-icon-v29-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/track-me-icon-v29-maskable-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "standalone"
  ],
  "prefer_related_applications": false
}
